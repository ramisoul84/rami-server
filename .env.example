# Copy to .env and fill in the blanks.
# Docker's env_file does not strip trailing comments: keep comments on their own lines.

APP_NAME=rami-server
APP_VERSION=1.0.0
# development | staging | production
APP_ENV=production

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
# stdout | file | both
LOG_OUTPUT=stdout
LOG_FILE_PATH=logs/app.log
LOG_SERVICE=rami-server
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

HTTP_PORT=8000
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Comma-separated origins allowed to call the API from a browser
HTTP_CORS_ORIGINS=https://ramisuliman.com

DB_HOST=postgres
DB_PORT=5432
DB_USER=rami
DB_PASSWORD=
DB_NAME=rami_server
DB_SSL_MODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s
# IANA timezone: used for daily stats, bot message times and the digest schedule
DB_TIMEZONE=Europe/Moscow

# GeoLite2-Country or GeoLite2-City database (optional)
GEO_MMDB_PATH=./data/GeoLite2-Country.mmdb

# Leave the token empty to run without the bot
TELEGRAM_BOT_TOKEN=
# Telegram usernames that get alerts and the admin panel, comma-separated, without @
TELEGRAM_ADMINS=ramisoul
TELEGRAM_SITE_URL=https://ramisuliman.com
# Local hour (DB_TIMEZONE) of the daily digest; -1 turns it off
TELEGRAM_DIGEST_HOUR=21

AUTH_ADMIN_USERNAME=ramisoul
# bcrypt hash, e.g.: htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
AUTH_ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g.: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_ACCESS_DURATION=168h
