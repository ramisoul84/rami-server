APP_NAME=rami-server
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=true

# Logger
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=both   # both, stdout , file
LOG_FILE_PATH=logs/app.log
LOG_SERVICE=rami-server
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_CORS_ORIGINS=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_USER=ramisoul
DB_PASSWORD=
DB_NAME=rami_server
DB_SSL_MODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s
DB_TIMEZONE=Europe/Moscow

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMINS=ramisoul

AUTH_ADMIN_USERNAME=ramisoul
AUTH_ADMIN_PASSWORD_HASH=
AUTH_JWT_SECRET=
AUTH_ACCESS_DURATION=168h